# Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# Never commit real secrets. This file contains variable NAMES + safe placeholders only.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the Express server (default: 5000)
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate_db
DB_USER=postgres
DB_PASSWORD=

# Test Database (used by vitest — NEVER point at dev or production data)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=real_estate_db_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=

# Session Secret (required - server will not start without it)
SESSION_SECRET_KEY=

# Frontend / application origin allowed for credentialed CORS.
# Development default is http://localhost:3000.
# Production must be the public HTTPS URL of the deployed app.
CLIENT_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Production-only notes (names, no values):
#
# On a managed PostgreSQL (e.g. Render Postgres / Neon / Supabase) set:
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
# The production DB config enables SSL automatically (rejectUnauthorized: false).
# There is NO DATABASE_URL support — use the five DB_* variables above.
#
# Provision the production database with the NON-DESTRUCTIVE script:
#   npm run seed:demo        (installs schema only if empty + applies migrations +
#                             seeds Arabic/English demo data if absent)
# Never run `npm run seed` against production — it drops all data.
#
# Frontend: the built SPA is served by Express in production (same-origin),
# so no frontend build variable is required. If you instead deploy the frontend
# to a separate origin, build it with:
#   REACT_APP_API_BASE_URL=https://backend.example.com/api
# and set CLIENT_URL to the frontend origin.
# --------------------------------------------------------------------------