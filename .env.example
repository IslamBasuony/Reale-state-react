# Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# Never commit real secrets. This file contains variable NAMES + safe placeholders only.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the Express server (default: 5000)
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate_db
DB_USER=postgres
DB_PASSWORD=

# Test Database (used by vitest — NEVER point at dev or production data)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=real_estate_db_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=

# Session Secret (required - server will not start without it)
SESSION_SECRET_KEY=

# Frontend / application origin allowed for credentialed CORS.
# Development default is http://localhost:3000.
# Production must be the public HTTPS URL of the deployed app.
CLIENT_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Production-only notes (names, no values):
#
# Production database = Supabase free PostgreSQL (external; NOT created by
# Render). Fill these five variables with your Supabase project values
# (Project Settings -> Database -> Connection string):
#   DB_HOST=db.<project>.supabase.co
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USER=postgres
#   DB_PASSWORD=<your supabase database password>
# The production DB config enables SSL automatically (rejectUnauthorized: false),
# which satisfies Supabase's SSL requirement. There is NO DATABASE_URL support —
# use the five DB_* variables above.
#
# Provision the production database with the NON-DESTRUCTIVE script.
# MUST run with NODE_ENV=production so the SSL-enabled production pool is used:
#   NODE_ENV=production DB_HOST=db.<project>.supabase.co DB_PORT=5432 \
#   DB_NAME=postgres DB_USER=postgres DB_PASSWORD=<password> npm run seed:demo
#   (installs schema only if empty + applies migrations +
#    seeds Arabic/English demo data if absent — idempotent, safe to re-run)
# Never run `npm run seed` against production — it drops all data.
#
# On Render: SESSION_SECRET_KEY is auto-generated at deploy time; the DB_* keys
# are declared in render.yaml with `sync: false` and filled by hand in the
# service's "Environment" tab (so their real values never touch git).
# Locally, generate your own SESSION_SECRET_KEY (e.g. `openssl rand -hex 32`).
#
# Frontend: the built SPA is served by Express in production (same-origin),
# so no frontend build variable is required. If you instead deploy the frontend
# to a separate origin, build it with:
#   REACT_APP_API_BASE_URL=https://backend.example.com/api
# and set CLIENT_URL to the frontend origin.
# --------------------------------------------------------------------------